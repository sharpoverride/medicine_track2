// Kusto Test Queries for MedicineTrack Telemetry
// These queries validate telemetry data ingestion and provide useful analysis

// ============================================================================
// HEALTH CHECKS
// ============================================================================

// 1. Recent traces (service availability check - last 2 minutes)
traces
| where timestamp > ago(2m)
| summarize count() by cloud_RoleName
| order by count_ desc

// 2. Table row counts (verify data ingestion)
union
  (traces | summarize TableName = "traces", RowCount = count()),
  (requests | summarize TableName = "requests", RowCount = count()),
  (dependencies | summarize TableName = "dependencies", RowCount = count()),
  (exceptions | summarize TableName = "exceptions", RowCount = count())
| order by TableName asc

// ============================================================================
// SERVICE MONITORING
// ============================================================================

// 3. Request volume by service (last hour)
requests
| where timestamp > ago(1h)
| summarize RequestCount = count(), AvgDuration = avg(duration) by cloud_RoleName, resultCode
| order by RequestCount desc

// 4. Error rate by service (last hour)
requests
| where timestamp > ago(1h)
| extend IsError = resultCode startswith "5" or success == "False"
| summarize ErrorRate = 100.0 * countif(IsError) / count(), TotalRequests = count() by cloud_RoleName
| where ErrorRate > 0
| order by ErrorRate desc

// 5. Service health overview (last 5 minutes)
requests
| where timestamp > ago(5m)
| summarize
    RequestCount = count(),
    AvgDuration = round(avg(duration), 2),
    P95Duration = round(percentile(duration, 95), 2),
    SuccessRate = round(100.0 * countif(success == "True") / count(), 2)
    by cloud_RoleName
| order by cloud_RoleName asc

// ============================================================================
// PERFORMANCE ANALYSIS
// ============================================================================

// 6. Slow requests (duration > 1000ms in last hour)
requests
| where timestamp > ago(1h) and duration > 1000
| project timestamp, cloud_RoleName, name, url, duration, resultCode, operation_Id
| order by duration desc
| take 20

// 7. Slow dependencies (duration > 100ms)
dependencies
| where timestamp > ago(1h) and duration > 100
| project timestamp, cloud_RoleName, name, type, target, duration, success, data
| order by duration desc
| take 20

// 8. Slowest operations by type
requests
| where timestamp > ago(1h)
| summarize
    Count = count(),
    AvgDuration = round(avg(duration), 2),
    P50 = round(percentile(duration, 50), 2),
    P95 = round(percentile(duration, 95), 2),
    P99 = round(percentile(duration, 99), 2)
    by operation_Name, cloud_RoleName
| where Count > 5
| order by P95 desc
| take 20

// ============================================================================
// DEPENDENCY ANALYSIS
// ============================================================================

// 9. Dependencies by type and target
dependencies
| where timestamp > ago(1h)
| summarize
    CallCount = count(),
    AvgDuration = round(avg(duration), 2),
    FailureCount = countif(success == "False"),
    FailureRate = round(100.0 * countif(success == "False") / count(), 2)
    by type, target, cloud_RoleName
| order by CallCount desc

// 10. Database query analysis
dependencies
| where timestamp > ago(1h) and type == "SQL"
| project timestamp, cloud_RoleName, name, data, duration, success
| order by duration desc
| take 20

// 11. HTTP dependency calls
dependencies
| where timestamp > ago(1h) and type == "HTTP"
| summarize
    CallCount = count(),
    AvgDuration = round(avg(duration), 2),
    FailureCount = countif(success == "False")
    by target, cloud_RoleName
| order by CallCount desc

// ============================================================================
// ERROR ANALYSIS
// ============================================================================

// 12. Exception summary (last 24 hours)
exceptions
| where timestamp > ago(24h)
| summarize
    ExceptionCount = count(),
    AffectedOperations = dcount(operation_Id),
    FirstSeen = min(timestamp),
    LastSeen = max(timestamp)
    by type, innermostType, cloud_RoleName
| order by ExceptionCount desc
| take 20

// 13. Recent exceptions with details
exceptions
| where timestamp > ago(1h)
| project timestamp, cloud_RoleName, type, message, innermostMessage, operation_Id, stack
| order by timestamp desc
| take 10

// 14. Failed requests with context
requests
| where timestamp > ago(1h) and success == "False"
| project timestamp, cloud_RoleName, name, url, resultCode, duration, operation_Id
| order by timestamp desc
| take 20

// ============================================================================
// DISTRIBUTED TRACING
// ============================================================================

// 15. Trace a request across services (replace <trace-id> with actual operation_Id)
let traceId = "<replace-with-actual-trace-id>";
union
  (requests | where operation_Id == traceId),
  (dependencies | where operation_Id == traceId),
  (traces | where operation_Id == traceId),
  (exceptions | where operation_Id == traceId)
| project timestamp, itemType, cloud_RoleName, name, duration, success, message
| order by timestamp asc

// 16. Find trace IDs with multiple services (distributed traces)
requests
| where timestamp > ago(1h)
| join kind=inner (
    dependencies
    | where timestamp > ago(1h)
) on operation_Id
| summarize
    Services = make_set(cloud_RoleName),
    ServiceCount = dcount(cloud_RoleName),
    TotalDuration = sum(duration)
    by operation_Id
| where ServiceCount > 1
| order by ServiceCount desc
| take 10

// ============================================================================
// LOG ANALYSIS
// ============================================================================

// 17. Log severity distribution (last hour)
traces
| where timestamp > ago(1h)
| extend Severity = case(
    severityLevel == 0, "Verbose",
    severityLevel == 1, "Information",
    severityLevel == 2, "Warning",
    severityLevel == 3, "Error",
    severityLevel == 4, "Critical",
    "Unknown"
)
| summarize Count = count() by Severity, cloud_RoleName
| order by cloud_RoleName asc, Severity asc

// 18. Errors and warnings from logs
traces
| where timestamp > ago(1h) and severityLevel >= 2
| project timestamp, cloud_RoleName, severityLevel, message, operation_Id
| order by severityLevel desc, timestamp desc
| take 50

// 19. Search logs for specific keywords (replace <keyword>)
traces
| where timestamp > ago(1h)
| where message contains "<keyword>"
| project timestamp, cloud_RoleName, severityLevel, message, operation_Id
| order by timestamp desc
| take 20

// ============================================================================
// AGGREGATED INSIGHTS
// ============================================================================

// 20. Service interaction map (last hour)
dependencies
| where timestamp > ago(1h)
| summarize CallCount = count(), AvgDuration = round(avg(duration), 2)
    by Caller = cloud_RoleName, DependencyType = type, Target = target
| order by CallCount desc
| take 30

// 21. Request timeline (5-minute buckets, last hour)
requests
| where timestamp > ago(1h)
| summarize
    RequestCount = count(),
    AvgDuration = round(avg(duration), 2),
    ErrorCount = countif(success == "False")
    by bin(timestamp, 5m), cloud_RoleName
| order by timestamp asc

// 22. Overall system health (last 5 minutes)
union
  (requests | where timestamp > ago(5m) | summarize Metric = "Requests", Value = count()),
  (dependencies | where timestamp > ago(5m) | summarize Metric = "Dependencies", Value = count()),
  (traces | where timestamp > ago(5m) | summarize Metric = "Traces", Value = count()),
  (exceptions | where timestamp > ago(5m) | summarize Metric = "Exceptions", Value = count()),
  (requests | where timestamp > ago(5m) | summarize Metric = "Avg Request Duration (ms)", Value = round(avg(duration), 2)),
  (requests | where timestamp > ago(5m) and success == "False" | summarize Metric = "Failed Requests", Value = count())
| order by Metric asc
